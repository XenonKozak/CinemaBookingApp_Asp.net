## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This file is based on the GitHub VisualStudio .gitignore template

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the TestResults folder
#TestResults/

# MSTest test Results
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-agent.log

# JetBrains Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code
.vscode/

# Node.js / Frontend
node_modules/
dist/
dist-ssr/
*.local
.env
.env.*
!.env.example
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache
.next
.nuxt
.output
.cache
.vuepress/dist
.temp
.docusaurus
.serverless
.fusebox/
.dynamodb/
.tern-port
frontend/node_modules/
frontend/dist/

# Entity Framework Core
*.db
*.db-shm
*.db-wal

# User settings
appsettings.json
!appsettings.json
appsettings.Development.json
